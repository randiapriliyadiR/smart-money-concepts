# ─── constants ────────────────────────────────────────────────────────────────
BULLISH_LEG = 1
BEARISH_LEG = 0
BULLISH = 1
BEARISH = -1

GREEN = rgba(8, 153, 129, 1.0)
RED = rgba(242, 54, 69, 1.0)
BLUE = rgba(33, 87, 243, 1.0)
GRAY = rgba(135, 139, 148, 1.0)
MONO_BULLISH = rgba(178, 181, 190, 1.0)
MONO_BEARISH = rgba(93, 96, 107, 1.0)

_FONT_TINY = 8
_FONT_SMALL = 10
_FONT_NORMAL = 12

_OB_POOL = 8
_FVG_POOL = 6
_STRUCT_POOL = 12
_EQHL_POOL = 6
_SWING_LBL_POOL = 6
_OB_LOOKBACK = 60
_LINE_EXTEND_BARS = 20.0
_BAR_DUR_FALLBACK = 60.0
_ATR_LEN = 100


def _font_size(size_str: str) -> int:
    if size_str == 'Tiny':
        return _FONT_TINY
    if size_str == 'Normal':
        return _FONT_NORMAL
    return _FONT_SMALL


@sec_context
def FvgContext(self) -> tuple[float, float, float, float, float, float, float, float]:
    # Matches Pine request.security lookahead values used by LuxAlgo FVG
    return (
        self.close[1],
        self.open[1],
        self.time[1],
        self.high[0],
        self.low[0],
        self.time[0],
        self.high[2],
        self.low[2],
    )


@sec_context
def LevelsContext(self) -> tuple[float, float, float, float]:
    return self.high[1], self.low[1], self.time[1], self.time[0]


@indicator('Smart Money Concepts', overlay_main_pane=True)

